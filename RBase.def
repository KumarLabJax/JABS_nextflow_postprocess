Bootstrap: docker
From: rocker/r-ver:4.3.1

%files
    renv.lock /opt/renv.lock

%post
    apt-get update
    apt-get -y install \
        libcurl4-gnutls-dev \
        libssl-dev \
        libxml2-dev \
        libgit2-dev

    R -e "install.packages('renv', repos='https://cloud.r-project.org')"

    mkdir -p /opt/project
    cp /opt/renv.lock /opt/project/

    R -e "setwd('/opt/project'); renv::restore()"

%environment
    export LANG=en_US.UTF-8
    export LC_ALL=en_US.UTF-8

%runscript
    exec R "$@"
